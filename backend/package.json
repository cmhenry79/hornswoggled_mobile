{
  "name": "hornswoggled-backend",
  "version": "1.0.0",
  "description": "Hornswoggled Game Platform Backend - Cloud Run Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "docker:build": "docker build -t hornswoggled-backend .",
    "docker:run": "docker run -p 8080:8080 hornswoggled-backend"
  },
  "keywords": ["game", "multiplayer", "party-game", "realtime"],
  "author": "Hornswoggled Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "firebase-admin": "^12.0.0",
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/storage": "^7.7.0",
    "@google/generative-ai": "^0.2.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "nanoid": "^5.0.4",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
