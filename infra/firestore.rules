rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isRoomHost(roomData) {
      return isAuthenticated() && request.auth.uid == roomData.hostId;
    }

    function isInRoom(roomData) {
      return isAuthenticated() &&
             request.auth.uid in roomData.participants.map(p => p.userId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow read: if true; // Anyone can browse rooms
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                      (isRoomHost(resource.data) || isInRoom(resource.data));
      allow delete: if isAuthenticated() && isRoomHost(resource.data);
    }

    // Games collection
    match /games/{gameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false; // Games should not be deleted
    }

    // Rounds collection
    match /rounds/{roundId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Word packs collection
    match /word_packs/{packId} {
      allow read: if true; // Public catalog
      allow write: if false; // Admin only via backend
    }

    // Words collection
    match /words/{wordId} {
      allow read: if true;
      allow write: if false; // Admin only via backend
    }

    // Bots collection
    match /bots/{botId} {
      allow read: if true;
      allow write: if false; // Admin only via backend
    }

    // Store items collection
    match /store_items/{itemId} {
      allow read: if true;
      allow write: if false; // Admin only via backend
    }

    // Purchases collection
    match /purchases/{purchaseId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Gallery items collection
    match /gallery_items/{itemId} {
      allow read: if true; // Public gallery
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Analytics events collection
    match /analytics_events/{eventId} {
      allow read: if false; // Backend only
      allow create: if true; // Allow anonymous tracking
      allow update, delete: if false;
    }

    // Leaderboards collection
    match /leaderboards/{boardId} {
      allow read: if true; // Public leaderboards
      allow write: if false; // Backend only
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
